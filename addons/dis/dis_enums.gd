class_name DisEnums
## Names for DIS enumeration values (SISO-REF-010) and a DIS entity type -> MIL-STD-2525D symbol bridge.
##
## [codeblock]
## DisEnums.get_entity_type_name(pdu.entity_type)            # "M1A2 Abrams" (most specific known name)
## DisEnums.get_enum_name("force_id", pdu.force_id)           # "Friendly"
## DisEnums.entity_type_to_sidc(pdu.entity_type, pdu.force_id) # "10031500001202000000" for godot-milsymbol
## [/codeblock]
##
## Data in addons/dis/data/, generated by tools/enums.py and tools/sidc_map.py.
## SISO-REF-010 enumeration data: Reprinted with permission from SISO Inc. (not covered by the MIT license).
## The symbol mapping is approximate: DIS categories and 2525D symbols don't line up one to one.

const DATA_DIR := "res://addons/dis/data/"

## enums.json "tables" keys usable with get_enum_name().
const TABLES: PackedStringArray = [
	"force_id", "entity_kind", "platform_domain", "platform_land_category", "platform_air_category",
	"platform_surface_category", "platform_subsurface_category", "platform_space_category",
	"munition_domain", "munition_category", "country", "dead_reckoning_algorithm",
]

const _PLATFORM_CATEGORY_TABLES := {
	1: "platform_land_category", 2: "platform_air_category", 3: "platform_surface_category",
	4: "platform_subsurface_category", 5: "platform_space_category",
}

static var _enums: Dictionary
static var _entity_types: Dictionary
static var _sidc_map: Dictionary


static func _load(file: String) -> Dictionary:
	var json := load(DATA_DIR + file) as JSON
	if json == null or typeof(json.data) != TYPE_DICTIONARY:
		push_error("DisEnums: cannot load %s%s" % [DATA_DIR, file])
		return {}
	return json.data


static func _tables() -> Dictionary:
	if _enums.is_empty():
		_enums = _load("enums.json")
	return _enums.get("tables", {})


static func _tree() -> Dictionary:
	if _entity_types.is_empty():
		_entity_types = _load("entity_types.json")
	return _entity_types.get("entity_types", {})


static func _symbols() -> Dictionary:
	if _sidc_map.is_empty():
		_sidc_map = _load("sidc_map.json")
	return _sidc_map


## Source, version, SHA-256 and attribution of the SISO-REF-010 data.
static func get_source() -> Dictionary:
	_tables()
	return _enums.get("source", {})


## Name of `value` in a SISO-REF-010 table (see TABLES), or "" if unknown.
static func get_enum_name(table: String, value: int) -> String:
	return _tables().get(table, {}).get(str(value), "")


## The domain table that applies to an entity kind (munitions have their own), or "".
static func get_domain_table(kind: int) -> String:
	if kind == 2:
		return "munition_domain"
	if kind in [1, 3, 4, 5, 7, 8, 9]:
		return "platform_domain"
	return ""


## The generic category table for a kind / domain (platforms per domain, munitions), or "".
static func get_category_table(kind: int, domain: int) -> String:
	if kind == 1:
		return _PLATFORM_CATEGORY_TABLES.get(domain, "")
	if kind == 2:
		return "munition_category"
	return ""


## All 7 fields of an entity type with names where SISO-REF-010 has them:
## { kind, domain, country, category, subcategory, specific, extra, name }.
## Each field is { value, name }; `name` is the most specific name found (country-specific entries first,
## then the generic category table).
static func describe_entity_type(entity_type: PackedInt32Array) -> Dictionary:
	var v := entity_type.duplicate()
	v.resize(7)
	var fields := ["kind", "domain", "country", "category", "subcategory", "specific", "extra"]
	var result := {}
	for i in 7:
		result[fields[i]] = {"value": v[i], "name": ""}
	result.kind.name = get_enum_name("entity_kind", v[0])
	result.domain.name = get_enum_name(get_domain_table(v[0]), v[1]) if get_domain_table(v[0]) != "" else ""
	result.country.name = get_enum_name("country", v[2])
	var category_table := get_category_table(v[0], v[1])
	if category_table != "":
		result.category.name = get_enum_name(category_table, v[3])

	# Country-specific tree: category -> subcategory -> specific -> extra.
	var best := ""
	var nodes: Dictionary = _tree().get("%d:%d:%d" % [v[0], v[1], v[2]], {})
	for level in range(3, 7):
		if v[level] == 0 and level > 3:
			break
		var node: Dictionary = nodes.get(str(v[level]), {})
		if node.is_empty():
			break
		result[fields[level]].name = node.get("n", "")
		best = result[fields[level]].name
		nodes = node.get("c", {})

	if best == "":
		# Category, then domain: value 0 means "Other / not specified", so it doesn't name anything.
		for field in ["category", "domain"]:
			if result[field].name != "" and result[field].value != 0:
				best = result[field].name
				break
	if best == "":
		best = result.kind.name
	result.name = best
	return result


## The most specific known name of an entity type ("" if nothing is known).
static func get_entity_type_name(entity_type: PackedInt32Array) -> String:
	return describe_entity_type(entity_type).name


## MIL-STD-2525D standard identity digit for a DIS force ID: friendly -> "3", opposing -> "6", neutral -> "4",
## other -> "1" (unknown). Force IDs 4-9 ("Friendly 2", "Opposing 2", ...) count as their base force.
static func force_to_standard_identity(force_id: int) -> String:
	if force_id <= 0 or force_id > 9:
		return "1"
	return ["3", "6", "4"][(force_id - 1) % 3]


## A MIL-STD-2525D (number) SIDC for an entity type and force ID, for godot-milsymbol. Approximate: the
## category decides the symbol (tank, fighter, frigate ...); entity types without a mapping get a plain frame of
## the right dimension. `status` is the 2525D status digit: 0 = present, 1 = planned / anticipated,
## 2 = fully capable, 3 = damaged, 4 = destroyed, 5 = full to capacity (see appearance_to_status()).
static func entity_type_to_sidc(entity_type: PackedInt32Array, force_id: int = 1, status: int = 0) -> String:
	var v := entity_type.duplicate()
	v.resize(7)
	var table: Dictionary = _symbols().get("map", {})
	var symbol: Array = []
	for key in ["%d:%d:%d" % [v[0], v[1], v[3]], "%d:%d" % [v[0], v[1]], str(v[0])]:
		if table.has(key):
			symbol = table[key]
			break
	if symbol.is_empty():
		symbol = _symbols().get("domain_fallback", {}).get(str(v[1]), ["10", "000000", "00"])
	return "100%s%s%d000%s%s00" % [force_to_standard_identity(force_id), symbol[0], clampi(status, 0, 5), symbol[1],
			symbol[2]]


## 2525D status digit for a platform's DIS appearance: damage bits 3-4 (slight / moderate = damaged, destroyed).
static func appearance_to_status(appearance: int) -> int:
	match (appearance >> 3) & 3:
		1, 2:
			return 3
		3:
			return 4
	return 0
