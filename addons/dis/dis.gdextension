[configuration]

entry_symbol = "godot_dis_library_init"
compatibility_minimum = "4.3"
reloadable = true

[libraries]

windows.debug.x86_64 = "res://addons/dis/bin/windows/libgodot_dis.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/dis/bin/windows/libgodot_dis.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/dis/bin/linux/libgodot_dis.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/dis/bin/linux/libgodot_dis.linux.template_release.x86_64.so"
macos.debug = "res://addons/dis/bin/macos/libgodot_dis.macos.template_debug.universal.dylib"
macos.release = "res://addons/dis/bin/macos/libgodot_dis.macos.template_release.universal.dylib"
